{
  "name": "radar-vecinal",
  "version": "0.0.0",
  "description": "Plataforma de seguridad ciudadana y reporte de incidencias para municipalidades.",
  "keywords": [
    "civic-tech",
    "citizen-reporting",
    "panic-alert",
    "missing-persons",
    "radar-vecinal",
    "peru"
  ],
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./tools/enforce-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck",
    "cap:init": "npx cap init",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:build:android": "npx cap build android"
  },
  "private": true,
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
