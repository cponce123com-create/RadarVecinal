# ── Base de Datos ───────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/radarvecinal?sslmode=require

# ── Autenticación ──────────────────────────────────────────────────────────
# JWT secret key (generar con: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here
# License secret key (opcional, separado de JWT_SECRET para seguridad)
# Si no se define, usa JWT_SECRET como fallback. Se recomienda usar uno diferente.
# Generar con: openssl rand -base64 32
LICENSE_SECRET=your-license-secret-here

# ── Servidor ───────────────────────────────────────────────────────────────
# Puerto (Render asigna 10000 automáticamente)
PORT=3000
NODE_ENV=development

# ── Google Cloud Storage (opcional) ────────────────────────────────────────
# Para subida de imágenes a GCS
GCS_BUCKET_NAME=radarvecinal-uploads
GCS_PROJECT_ID=your-gcp-project-id
# Opción 1: Ruta a archivo JSON de service account
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# Opción 2: JSON directo del service account
GCS_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ── Redis (BullMQ Workers) ─────────────────────────────────────────────────
# URL de conexión Redis para workers de escalado de incidencias y expiración
# Puedes usar Redis local o Redis Cloud (Upstash, Redis.com, etc.)
REDIS_URL=redis://localhost:6379

# ── Seed ───────────────────────────────────────────────────────────────────
# Clave para ejecutar seed en producción (POST /api/seed con header x-seed-key)
SEED_KEY=my-secret-seed-key-2024
