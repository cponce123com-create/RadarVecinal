# ── Base de Datos ───────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (usar string -pooler para producción)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/radarvecinal?sslmode=require

# ── Autenticación ──────────────────────────────────────────────────────────
# JWT secret key (generar con: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here
# License secret key (opcional, separado de JWT_SECRET para seguridad)
# Si no se define, usa JWT_SECRET como fallback. Se recomienda usar uno diferente.
# Generar con: openssl rand -base64 32
LICENSE_SECRET=your-license-secret-here

# ── Servidor ───────────────────────────────────────────────────────────────
# Puerto (Render asigna 10000 automáticamente)
PORT=3000
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────────────────────────
# Orígenes permitidos para CORS (separados por coma)
# En producción: la URL del frontend en Render
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Super Admin ────────────────────────────────────────────────────────────
# Email del super administrador (OBLIGATORIO — sin default)
SUPER_ADMIN_EMAIL=tu-email@ejemplo.com

# ── Cloudinary (imágenes) ──────────────────────────────────────────────────
# Reemplaza a GCS. Obtén estos datos de https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ── RENIEC / DNI ──────────────────────────────────────────────────────────
# Token para consultar datos de DNI (api.decolecta.com)
RENIEC_API_TOKEN=tu-token-aqui
# URL base de la API (opcional, por defecto usa decolecta)
RENIEC_API_URL=https://api.decolecta.com/v1/reniec/dni

# ── Seed ───────────────────────────────────────────────────────────────────
# Clave para ejecutar seed en desarrollo (en producción esta ruta está deshabilitada)
# Debe ser una clave fuerte y rotarse periódicamente
SEED_KEY=my-secret-seed-key-2024

# ── Firebase Cloud Messaging (push notifications) ─────────────────────────
# JSON string de la cuenta de servicio de Firebase
# (Firebase Console → Project Settings → Service Accounts → Generate key)
FCM_SERVICE_ACCOUNT={"type":"service_account",...}

# ── SMTP (notificaciones por email) ───────────────────────────────────────
# Configuración del servidor SMTP para enviar emails de notificación
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=tu-usuario
SMTP_PASS=tu-contraseña
SMTP_FROM=noreply@radarvecinal.pe

# ── App ────────────────────────────────────────────────────────────────────
# URL pública de la aplicación (para enlaces en emails)
APP_URL=https://radarvecinal.pe

# ── Logging ────────────────────────────────────────────────────────────────
# Nivel de log: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
